# Environment variables for the NEERKAVAL backend.
# Copy to backend/.env and adjust. Never commit the real .env.
# Names below match the Settings fields in backend/app/core/config.py.

APP_MODE=LIVE
DATABASE_URL=sqlite:///./neerkaval.db

# Generate a strong random value for any real deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-in-production-use-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

OPENMETEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_SECONDS=600

# Comma-separated allowed frontend origins. Keep "*" only for local dev —
# credentialed requests (officer login) require explicit origins.
CORS_ORIGINS=*
